# ==============================================================================
# AtlasDesk 环境变量配置示例 (不含任何真实私密数据)
# 复制并重命名为 .env 使用：cp .env.example .env
# ==============================================================================

# --- 服务端通用配置 ---
APP_ENV=development
APP_NAME=atlasdesk
PORT=8080
API_BASE_URL=http://localhost:8080

# --- 跨域 (CORS) 配置，多个以逗号分隔 ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL + pgvector 数据库配置 ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=atlasdesk_user
DB_PASSWORD=atlasdesk_secret_change_me
DB_NAME=atlasdesk_db
DB_SSLMODE=disable

# --- Redis 缓存与后台队列配置 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- MinIO / S3 对象存储配置 ---
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=atlasdesk-docs
STORAGE_USE_SSL=false

# --- JWT 与安全密钥 (请在生产环境中更改为强随机密钥) ---
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
ENCRYPTION_KEY=32_bytes_aes_key_for_api_keys!

# --- 前端配置 (Vite 会自动注入 VITE_ 开头的变量) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
